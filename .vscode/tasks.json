{
  // Terminal > Run Task... (or Ctrl+Shift+P, "Run Task")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Record ASL signs (webcam)",
      "type": "shell",
      "command": "python",
      "args": ["training/record.py", "--name", "${input:who}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "focus": true, "panel": "dedicated" }
    },
    {
      "label": "2. Train the model",
      "type": "shell",
      "command": "python",
      "args": ["training/train.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "focus": true, "panel": "dedicated" }
    },
    {
      "label": "Install recording and training packages",
      "type": "shell",
      "command": "python -m pip install mediapipe opencv-python numpy torch",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "who",
      "type": "promptString",
      "description": "Who is signing? (a first name is fine)"
    }
  ]
}
